{
  "name": "@rosmeowtis/dsh-aria2-rpc",
  "version": "0.1.0",
  "description": "Control an existing aria2 JSON-RPC service from DSH. No bundled downloader.",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/Rosmeowtis/dsh-aria2-rpc.git" },
  "type": "module",
  "main": "./lib/src/index.js",
  "types": "./lib/src/index.d.ts",
  "icon": "./icon.svg",
  "exports": {
    ".": { "types": "./lib/src/index.d.ts", "import": "./lib/src/index.js" },
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": ["lib/src", "client.js", "locale/*.json", "icon.svg", "cordis.patch.yml", "README.md", "LICENSE"],
  "engines": { "node": ">=22.18", "dsh": "^0.2.1-rc.5" },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "platform": "web", "inject": ["@deepseek-ai/dsh-client-ui-plugin-manager", "@deepseek-ai/dsh-client-ui-settings"] }
  },
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --check client.js && node --test lib/test/*.test.js",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/schemastery": "^3.18.2",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.5",
    "@deepseek-ai/dsh-credentials": "0.2.1-rc.5",
    "@deepseek-ai/dsh-client-connection": "0.2.1-rc.5",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.5",
    "@deepseek-ai/dsh-plan-mode": "0.2.1-rc.5",
    "@deepseek-ai/dsh-sandbox-policy": "0.2.1-rc.5",
    "@deepseek-ai/dsh-settings": "0.2.1-rc.5",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.5",
    "@types/node": "^22.0.0",
    "typescript": "~5.9.3"
  }
}
